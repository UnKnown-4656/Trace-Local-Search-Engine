vector <string>camelcase(string &token){
    string current;
    vector <string> tokens;
    for(char c : token){
        if(isupper(c)){
            if(!current.empty())
            {
                tokens.push_back(current);
                current.clear();

            }
        }
        current+=c;
    }
    if(!current.empty()){
        tokens.push_back(current);
        current.clear();
    }

    return tokens;
}

